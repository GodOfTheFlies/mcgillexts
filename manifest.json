{
  "manifest_version": 3,
  "name": "McGill Better VSB",
  "version": "1.0.0",
  "description": "Enhance McGill VSB with professor ratings, student reviews and custom themes for a better course selection experience",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://vsb.mcgill.ca/*",
    "https://raw.githubusercontent.com/GodOfTheFlies/mcgillexts/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vsb.mcgill.ca/*"
      ],
      "js": [
        "html2canvas.min.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "McGill Better VSB",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}